# Supabase Configuration
# Copy this file to .env.local and fill in your actual values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Admin Configuration
VITE_ADMIN_EMAIL=admin@example.com

# =========================================================================
# PayPal (International Payments)
# =========================================================================
# 1) Get a PayPal developer account + create an app:
#    https://developer.paypal.com/dashboard/  ->  Apps & Credentials
# 2) For testing, use the SANDBOX client id. For production, switch to LIVE.
# 3) Set the matching secret in Supabase Edge Function secrets:
#      supabase secrets set PAYPAL_CLIENT_ID=...
#      supabase secrets set PAYPAL_CLIENT_SECRET=...
#      supabase secrets set PAYPAL_ENV=sandbox   (or "live")
#      supabase secrets set SITE_ORIGIN=https://kindredguild.org
# 4) Paste the same client id in js/supabase-client.js
#    (window.PAYPAL_CLIENT_ID = '...') so the SDK can load in the browser.
#    PayPal client IDs are public, so shipping them in JS is safe.
VITE_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
SITE_ORIGIN=https://kindredguild.org
