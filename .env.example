# Supabase Configuration
# Copy this file to .env.local and fill in your actual values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Admin Configuration
VITE_ADMIN_EMAIL=admin@example.com

# =========================================================================
# Email Notifications (Resend)
# =========================================================================
# 1) Sign up at https://resend.com and grab your API key.
# 2) Verify your sending domain (kindredguild.org) at
#    https://resend.com/emails -> Domains tab.
# 3) Set the secret on Supabase:
#      supabase secrets set RESEND_API_KEY=re_xxxxx --project-ref owpyqeubmfvtuqjaxauo
RESEND_API_KEY=
FROM_EMAIL=Kindred Guild <notifications@kindredguild.org>

# =========================================================================
# PayPal International Payments (Manual QR flow)
# =========================================================================
# The manual flow does NOT use the PayPal SDK or server-side capture.
# International users scan a QR code that opens paypal.me/<username>/<amount>
# in their PayPal app, pay manually, then click "I've Paid".
#
# You do NOT need to set PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET / PAYPAL_ENV
# secrets on Supabase — the manual flow has no server component.
#
# To configure the PayPal.me username, edit js/supabase-client.js:
#   window.PAYPAL_ME_USERNAME = 'your-paypal-me-username';
# (or use one of the runtime override options documented in SETUP.md)
VITE_PAYPAL_ME_USERNAME=
